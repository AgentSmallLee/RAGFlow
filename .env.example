# ============================================================
# RAGFlow 配置文件模板
# 使用方式：复制为 .env，然后填入你的配置
#   cp .env.example .env
# ============================================================

# ========== 聊天模型 (LLM) 配置 ==========
# 支持 OpenAI 兼容接口（通义千问、硅基流动、DeepSeek 等都支持）
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=
LLM_MODEL=qwen-plus

# ========== Embedding 模型配置 ==========
# 可以和 LLM 使用不同的服务商
# DashScope 模型（text-embedding-v3）不需要填 base_url
# 其他 OpenAI 兼容接口需要填 base_url
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v3

# ========== 文本切分配置 ==========
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ========== 向量检索配置 ==========
TOP_K=4
SIMILARITY_THRESHOLD=0.4

# ========== 向量数据库配置 ==========
VECTOR_DB_PATH=./data/vector_db
COLLECTION_NAME=rag_flow

# ========== 查询改写配置 ==========
ENABLE_QUERY_REWRITE=false
REWRITE_ON_EMPTY_ONLY=true

# ========== 混合检索配置 ==========
ENABLE_HYBRID_SEARCH=false
HYBRID_FUSION_METHOD=rrf
HYBRID_VECTOR_WEIGHT=0.7

# ========== 重排序 (Rerank) 配置 ==========
# 用交叉编码器对检索结果二次精排，提升准确率
# 需要在 DashScope 控制台开通 gte-rerank-v2 模型
ENABLE_RERANK=false
# Rerank 模型 API Key（留空则复用 EMBEDDING_API_KEY）
RERANK_API_KEY=
RERANK_MODEL=gte-rerank-v2
# 精排后返回的文档数量（应小于等于 TOP_K）
RERANK_TOP_N=3
# Rerank 分数阈值（低于此值的结果被过滤）
RERANK_THRESHOLD=0.0

# ========== 文档目录配置 ==========
DOCUMENTS_DIR=./data/documents
